\u7403\u961f\u53c2\u8d5b \u4e16\u754c\u676f\u8d5b\u4e8b\u89c4\u5219\uff1a 1.\u6bd4\u8d5b\u5305\u62ec\u5c0f\u7ec4\u8d5b\u30011/16\u51b3\u8d5b\u30011/8\u51b3\u8d5b\u30011/4\u51b3\u8d5b\u3001\u534a\u51b3\u8d5b\uff0c\u4e09\u56db\u540d\u51b3\u8d5b(\u5b63\u519b\u8d5b)\u53ca\u51b3\u8d5b\uff1b 2.\u9664\u5c0f\u7ec4\u8d5b\u5916\uff0c\u5176\u5b83\u5404\u8f6e\u91c7\u53d6\u5355\u573a\u6dd8\u6c70\u8d5b\u5f62\u5f0f\u51b3\u51fa\u80dc\u8d1f\u3002\u82e5\u672a\u80fd\u5206\u51fa\u80dc\u8d1f\uff0c\u53cc\u65b9\u987b\u5b8c\u6210\u4e0a\u3001\u4e0b\u534a\u573a\u540415\u5206\u949f\u7684\u52a0\u65f6\u8d5b\uff0c\u52a0\u65f6\u8d5b\u8fdb\u7403\u8f83\u591a\u8005\u80dc\u51fa\uff1b\u82e5\u4ecd\u672a\u80fd\u5206\u51fa\u80dc\u8d1f\uff0c\u5219\u53cc\u65b9\u4e92\u7f5a\u70b9\u7403\u51b3\u51fa\u80dc\u8d1f\uff1b 3.\u5c0f\u7ec4\u8d5b\u9636\u6bb5\u517148\u652f\u7403\u961f\u53c2\u52a0\uff0c\u5c0f\u7ec4\u8d5b\u5206\u621012\u7ec4\uff0c\u6bcf\u7ec44\u961f\uff0c4\u652f\u7403\u961f\u8fdb\u884c\u5355\u5faa\u73af\u76843\u573a\u6bd4\u8d5b\uff1b\u5404\u5c0f\u7ec4\u524d\u4e24\u540d\u4ee5\u53ca\u516b\u4e2a\u6210\u7ee9\u6700\u597d\u7684\u5c0f\u7ec4\u7b2c\u4e09\u540d\u517132\u652f\u7403\u961f\u664b\u7ea7\u6dd8\u6c70\u8d5b\uff1b \u4e16\u754c\u676f\u5c0f\u7ec4\u8d5b\u79ef\u5206\u89c4\u5219: \u82e5\u51fa\u73b0\u5206\u6570\u76f8\u540c\u7684\u7403\u961f\uff0c\u4f9d\u4e0b\u5217\u987a\u5e8f\u6392\u5217\u540d\u6b21(\u82e5\u591a\u652f\u7403\u961f\u540c\u5206\uff0c\u8981\u4e00\u8d77\u6bd4\u8f83\uff0c\u4e0d\u662f\u4e24\u4e24\u76f8\u4e92\u6bd4\u8f83)\uff1a a)\u76f8\u4e92\u6bd4\u8d5b\u79ef\u5206\u591a\u8005\u540d\u6b21\u5217\u524d\uff1b b)\u76f8\u4e92\u6bd4\u8d5b\u51c0\u80dc\u7403\u591a\u8005\u540d\u6b21\u5217\u524d\uff1b c)\u76f8\u4e92\u6bd4\u8d5b\u8fdb\u7403\u591a\u8005\u540d\u6b21\u5217\u524d\uff1b \u5982\u679c\u8d85\u8fc7\u4e24\u652f\u7403\u961f\u540c\u5206\uff0c\u5e76\u4e14\u5728\u6bd4\u8f83a-c\u540e\uff0c\u4ecd\u4e0d\u80fd\u5b8c\u5168\u5206\u51fa\u5148\u540e\uff0c\u5219\u9996\u5148\u6392\u9664\u80fd\u5206\u51fa\u5148\u540e\u768