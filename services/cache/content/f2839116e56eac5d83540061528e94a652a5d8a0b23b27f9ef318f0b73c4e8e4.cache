L\u540e\u7aef\u7528PHP\u7f16\u5199\u7684\u5f00\u6e90\u6d88\u606f\u677f\u3002 \u901a\u8fc7\u5f00\u653e\u6e90\u4ee3\u7801\u8ba1\u5212\u5c06\u5b9e\u73b0\u5bf9\u5176\u4ed6\u811a\u672c\u8bed\u8a00\u548c\u6570\u636e\u5e93\u7684\u652f\u6301\u3002 OpenBB -GPL\u57fa\u4e8eIansoft\u521b\u5efa\u7684 OpenBB \u3002 OpenBB Workspace\u5b9e\u6218\uff1a\u5982\u4f55\u4e3a\u4f60\u7684\u79c1\u52df\u56e2\u961f\u5b9a\u5236\u4e00\u4e2a\u4e13\u5c5e\u7684A \u80a1 / \u6e2f\u80a1 \u6295\u7814\u770b\u677f weixin_28746223\u7684\u535a\u5ba2 04-17 317 \u672c\u6587\u8be6\u7ec6 \u4ecb\u7ecd \u4e86\u5982\u4f55 \u4f7f\u7528 OpenBB Workspace\u4e3a\u79c1\u52df\u56e2\u961f\u5b9a\u5236A \u80a1 / \u6e2f\u80a1 \u6295\u7814\u770b\u677f\uff0c\u89e3\u51b3\u4f20\u7edf\u6570\u636e\u5b64\u5c9b\u95ee\u9898\u3002\u901a\u8fc7\u6574\u5408AKShare\u3001Tushare\u7b49\u6570\u636e\u6e90\uff0c\u6784\u5efa\u53ef\u89c6\u5316\u5206\u6790\u7ec4\u4ef6\uff0c\u5e76\u96c6\u6210AI\u6295\u7814\u52a9\u624b\uff0c\u5927\u5e45\u63d0\u5347\u56e2\u961f\u534f\u4f5c\u6548\u7387\u3002\u6587\u7ae0\u8fd8\u63d0\u4f9b\u4e86\u4ece\u6570\u636e\u63a5\u5165\u5230\u667a\u80fd\u9884\u8b66\u7cfb\u7edf\u7684\u5b8c\u6574\u5b9e\u6218\u6307\u5357\u3002 \u53c2\u4e0e\u8bc4\u8bba \u60a8\u8fd8\u672a\u767b\u5f55\uff0c\u8bf7\u5148 \u767b\u5f55 \u540e\u53d1\u8868\u6216\u67e5\u770b\u8bc4\u8bba Tushare\u5bf9\u63a5 OpenBB \u5206\u6790A \u80a1 \u4e0e \u6e2f\u80a1 \u5e02\u573a FinAnalyzer\u91d1\u878d\u5206\u6790\u5de5\u5177 08-02 2939 \u672c\u6587\u4e3b\u8981\u8bb2\u8ff0\u5982\u4f55 \u4f7f\u7528 Tushare\u4f5c\u4e3aOpennBB\u6570\u636e\u6e90\u3002 OpenBB \u7206\u706b\uff1a\u7528\u4e8e\u6295\u5582 AI-Agent \u7684\u5f00\u6e90\u6570\u636e\u5e73\u53f0 Stata\u8fde\u4eab\u4f1a 05-19 88 \u6458\u8981\uff1a OpenBB \u662f\u4e00\u4e2a\u5f00\u6e90 \u91d1\u878d \u6570\u636e\u5e73\u53f0\uff0c\u65e8\u5728\u89e3\u51b3 \u6570\u636e\u5206\u6790 \u4e2d\u6570\u636e\u63a5\u5165\u5206\u6563\u3001\u5de5\u4f5c\u6d41\u96be\u4ee5\u590d\u7528\u7684\u95ee\u9898\u3002\u5b83\u901a\u8fc7\u7edf\u4e00\u63a5\u53e3\u8fde\u63a5Python\u3001Excel\u3001API\u3001Workspace\u548cAI-Agent\uff0c\u5b9e\u73b0\u6570\u636e\u5728\u591a\u573a\u666f\u4e2d\u7684\u590d\u7528\u3002\u7279\u522b\u9002\u5408 \u91d1\u878d \u6295\u7814\u3001\u7ecf\u7ba1\u7814\u7a76\u3001\u6570\u636e\u79d1\u5b66\u6559\u5b66\u548cAI-Agent\u5b9e\u8df5\u3002\u5e73\u53f0\u4e0d\u4ec5\u63d0\u4f9b\u6570\u636e\u83b7\u53d6\u529f\u80fd\uff0c\u66f4\u6784\u5efa\u4e86\u6807\u51c6\u5316\u6570\u636e\u5de5\u4f5c\u6d41\uff0c\u652f\u6301AI-Agent\u8c03\u7528\u771f\u5b9e\u6570\u636e\u751f\u6210\u5206\u6790\u62a5\u544a\u3002 OpenBB \u4ee3\u8868\u4e86 \u6570\u636e\u5206\u6790 \u4ece\u5355\u70b9\u5de5\u5177\u5411\u5de5\u4f5c\u6d41\u548c\u6570\u636e\u63a5\u53e3\u5c42\u7ade\u4e89\u7684\u53d1\u5c55\u8d8b\u52bf\u3002 \u5982\u4f55 \u4f7f\u7528 AKShare\u4f5c\u4e3a OpenBB \u7684\u6570\u636e\u6e90 FinAnalyzer\u91d1\u878d\u5206\u6790\u5de5\u5177 07-04 3077 ` openbb _akshare`\u9879\u76ee\u662f OpenBB \u7684\u6570\u636e\u6e90\u6269\u5c55\u3002\u53ef\u4ee5\u7528\u4e8e\u67e5\u8be2A \u80a1 \u548c \u6e2f\u80a1 \u6570\u636e \u63ed\u5f00 \u6570\u636e\u5206\u6790 \u7684\u65b0\u7bc7\u7ae0\uff1a OpenBB \u91d1\u878d \u6570\u636e\u5e73\u53f0 weixin_44626085\u7684\u535a\u5ba2 01-04 1313 \u6458\u8981\uff1a OpenBB \u63a8\u51fa\u7684\u5f00\u6e90\u5de5\u5177\u96c6Open Data Platform (ODP)\u4e3a \u91d1\u878d \u4e0eAI\u9886\u57df\u63d0\u4f9b\u9ad8\u6548\u6570\u636e\u6574\u5408\u65b9\u6848\uff0c\u652f\u6301\u591a\u573a\u666f\u5e94\u7528\uff08\u5982Python\u73af\u5883\u3001AI\u4ee3\u7406\u7b49\uff09\u3002\u901a\u8fc7\u7b80\u5355\u5b89\u88c5\uff08pip install openbb \uff09\u548c\u4ee3\u7801\u8c03\u7528\uff0c\u7528\u6237\u53ef\u5feb\u901f\u83b7\u53d6\u5e76\u5904\u7406\u6570\u636e\uff08\u5982 \u80a1 \u4ef7\uff09\u3002ODP\u4e0e OpenBB Workspace\u65e0\u7f1d\u96c6\u6210\uff0c\u652f\u6301\u53ef\u89c6\u5316\u4e0eAI\u4ee3\u7406\u534f\u540c\u5206\u6790\u3002\u5b89\u88c5\u6307\u5357\u6db5\u76d6Python\u5305\u548cCLI\u5de5\u5177\uff0c\u5e76\u5bf9\u6bd4\u4e86QuantConnect\u7b49\u7c7b\u4f3c\u5e73\u53f0\u3002ODP\u901a\u8fc7\u201c\u8fde\u63a5\u4e00\u6b21\uff0c\u968f\u5904\u6d88\u8d39\u201d\u8bbe\u8ba1\uff0c\u663e\u8457\u63d0\u5347\u6570\u636e\u7075\u6d3b\u6027\u548c\u53ef\u8bbf\u95ee\u6027\u3002 OpenBB - \u514d\u8d39\u4e14\u5b8c\u5168\u5f00\u6e90\u7684 \u91d1\u878d \u5e73\u53f0 AI\u5de5\u7a0b\u5316\u3001\u5f00\u6e90\u5206\u4eab\u3001\u6587\u6863\u7ffb\u8bd1\u3001\u4ee3\u7801\u7b14\u8bb0 01-23 6547 OpenBB \u662f\u7b2c\u4e00\u4e2a\u514d\u8d39\u4e14\u5b8c\u5168\u5f00\u6e90\u7684 \u91d1\u878d \u5e73\u53f0\u3002 \u63d0\u4f9b\u5bf9 \u80a1 \u7968\u3001\u671f\u6743\u3001\u52a0\u5bc6\u8d27\u5e01\u3001\u5916\u6c47\u3001\u5b8f\u89c2\u7ecf\u6d4e\u3001\u56fa\u5b9a\u6536\u76ca\u7b49\u7684\u8bbf\u95ee\uff0c\u540c\u65f6\u8fd8\u63d0\u4f9b\u5e7f\u6cdb\u7684\u6269\u5c55\uff0c\u4ee5\u6839\u636e\u7528\u6237\u9700\u6c42\u589e\u5f3a\u7528\u6237\u4f53\u9a8c\u3002 AI\u4e4b OpenBB \uff1a OpenBB (\u514d\u8d39\u4e14\u5b8c\u5168\u5f00\u6e90\u7684 \u91d1\u878d \u5206\u6790\u5e73\u53f0)\u7684\u7b80\u4ecb\u3001\u5b89\u88c5\u548c \u4f7f\u7528 \u65b9\u6cd5\u3001\u6848\u4f8b\u5e94\u7528\u4e4b\u8be6\u7ec6\u653b\u7565 \u70ed\u95e8\u63a8\u8350 \u5934\u90e8AI\u793e\u533a\u5982\u6709\u9080\u535a\u4e3bAI\u4e3b\u9898\u6f14\u8bb2\u8bf7\u79c1\u4fe1\u2014\u5fc3\u6bd4\u5929\u9ad8\uff0c\u4ed7\u5251\u8d70\u5929\u6daf\uff0c\u4fdd\u6301\u70ed\u7231\uff0c\u5954\u8d74\u5411\u68a6\u60f3\uff01\u4f4e\u8c03\uff0c\u4e13\u6ce8\uff0c\u8c26\u865a\uff0c\u81ea\u5f8b\uff0c\u53cd\u601d\uff0c\u6210\u957f\uff0c\u8fd8\u7b97\u6bd4\u8f83\u6b63\u80fd\u91cf\u7684\u535a\u4e3b\uff0c\u516c\u76ca\u514d\u8d39\u4f20\u64ad\u2026\u5185\u5fc3\u7279\u522b\u60f3\u5728AI\u754c\u505a\u51fa\u4e00\u4e9b\u53ef\u4ee5\u63a8\u8fdb\u5386\u53f2\u8fdb\u7a0b\u5f71\u54cd\u529b\u7684\u6280\u672f(\u5174\u8da3\u4f7f\u7136\uff0c\u6709\u70b9\u5c0f\u60c5\u6000\uff0c\u4e5f\u6709\u70b9\u4f7f\u547d\u611f\u5440 08-20 1\u4e07+ \u200b AI\u4e4b OpenBB \uff1a OpenBB (\u514d\u8d39\u4e14\u5b8c\u5168\u5f00\u6e90\u7684 \u91d1\u878d \u5206\u6790\u5e73\u53f0)\u7684\u7b80\u4ecb\u3001\u5b89\u88c5\u548c \u4f7f\u7528 \u65b9\u6cd5\u3001\u6848\u4f8b\u5e94\u7528\u4e4b\u8be6\u7ec6\u653b\u7565 \u76ee\u5f55 OpenBB \u7684\u7b80\u4ecb OpenBB \u7684\u5b89\u88c5\u548c \u4f7f\u7528 \u65b9\u6cd5 OpenBB \u7684\u6848\u4f8b\u5e94\u7528 OpenBB \u7684\u7b80\u4ecb 2024\u5e745\u6708\u53d1\u5e03\uff0c OpenBB \u662f\u4e00\u6b3e\u9996\u4e2a\u514d\u8d39\u4e14\u5b8c\u5168\u5f00\u6e90\u7684 \u91d1\u878d \u5206\u6790\u5e73\u53f0\u3002\u5b83\u63d0\u4f9b\u4e86\u5168\u9762\u7684\u6570\u636e\u8bbf\u95ee\u652f\u6301\uff0c\u5305\u62ec\u4f46\u4e0d\u9650\u4e8e \u80a1 \u7968\u3001\u671f\u6743\u3001\u52a0\u5bc6\u8d27\u5e01\u3001\u5916\u6c47\u3001\u5b8f\u89c2\u7ecf\u6d4e\u6307\u6807\u3001\u56fa\u5b9a\u6536\u76ca\u7b49\u3002\u6b64\u5916\uff0c\u8be5\u5e73\u53f0\u8fd8\u63d0\u4f9b\u4e86\u5e7f\u6cdb\u7684\u6269\u5c55\u529f\u80fd\uff0c\u53ef\u4ee5\u6839\u636e\u7528\u6237\u7684\u7279\u5b9a\u9700\u6c42\u8fdb\u4e00\u6b65\u589e\u5f3a\u5176\u529f\u80fd\u548c\u7528\u6237\u4f53\u9a8c\u3002 GitHub\u5730\u5740\uff1a Finanalyzer\uff1a\u5f00\u6e90\u7248 OpenBB Workspace \u6765\u4e86\uff01 FinAnalyzer\u91d1\u878d\u5206\u6790\u5de5\u5177 06-11 203 \u5f00\u6e90 \u91d1\u878d \u5206\u6790\u5de5\u5177Finanalyzer\uff1a\u4e2a\u4eba\u7528\u6237\u7684 OpenBB \u66ff\u4ee3\u65b9\u6848 \u9488\u5bf9 OpenBB Workspace\u5b58\u5728\u7684\u8bed\u8a00\u969c\u788d\u548c\u529f\u80fd\u9650\u5236\uff0c\u4f5c\u8005\u5f00\u53d1\u4e86\u5f00\u6e90\u66ff\u4ee3\u54c1Finanalyzer\u3002 \u4e0d\u6b62\u524d\u7aef\uff01\u4e00\u6587\u8bfb\u61c2Finanalyzer\u5b8c\u6574\u5f00\u6e90 \u91d1\u878d \u5206\u6790\u751f\u6001\uff08\u7eed\u7bc7\uff09 \u6700\u65b0\u53d1\u5e03 FinAnalyzer\u91d1\u878d\u5206\u6790\u5de5\u5177 06-11 205 Finanalyzer\u662f\u4e00\u5957\u9488\u5bf9\u56fd\u5185\u5e02\u573a\u7684\u5f00\u6e90 \u91d1\u878d \u5206\u6790\u5de5\u4f5c\u53f0\uff0c\u5b8c\u6574\u751f\u6001\u5305\u542b\u524d\u7aef\u5e94\u7528\u3001\u540e\u7aefAPI\u3001\u672c\u571f\u6570\u636e\u6e90\u6269\u5c55\u63d2\u4ef6\u7b49\u6a21\u5757\u3002\u5b83\u5ef6\u7eed OpenBB \u7684\u4f18\u79c0\u67b6\u6784\uff0c\u5e76\u9488\u5bf9\u4e2d\u6587\u7528\u6237\u75db\u70b9\u8fdb\u884c\u4f18\u5316\uff1a\u5168\u4e2d\u6587\u672c\u571f\u5316\u754c\u9762\u3001\u653e\u5f00\u7ec4\u4ef6\u9650\u5236\u3001\u5185\u7f6e\u5f00\u53d1\u8005\u5de5\u5177\uff0c\u5e76\u96c6\u6210AI\u5bf9\u8bdd\u548c\u91cf\u5316\u56de\u6d4b\u80fd\u529b\u3002 OpenBB \u6838\u5fc3\u5e73\u53f0\u6df1\u5ea6\u5256\u6790\uff1a\u4eceREST API\u5230\u6570\u636e\u8def\u7531 gitblog_00886\u7684\u535a\u5ba2 05-30 1020 OpenBB \u6838\u5fc3\u5e73\u53f0\u6df1\u5ea6\u5256\u6790\uff1a\u4eceREST API\u5230\u6570\u636e\u8def\u7531 \u3010\u514d\u8d39\u4e0b\u8f7d\u94fe\u63a5\u3011 OpenBB Terminal Investment Research for Everyone, Everywhere. \u9879\u76ee\u5730\u5740: https://gi... OpenBB \u5165\u95e8\u6307\u5357\uff1a\u5c0f\u767d\u4e5f\u80fd\u73a9\u8f6c \u91d1\u878d \u6570\u636e GoldenleafLynx28\u7684\u535a\u5ba2 11-30 1882 \u6700\u8fd1\u5728\u5b66 \u91d1\u878d \u6570\u636e\u5206\u6790 \uff0c\u53d1\u73b0 OpenBB \u8fd9\u4e2a\u5de5\u5177\u7279\u522b\u9002\u5408\u65b0\u624b\u5165\u95e8\u3002\u5b83\u628a\u590d\u6742\u7684 \u91d1\u878d \u6570\u636e\u63a5\u53e3\u5c01\u88c5\u6210\u7b80\u5355\u7684Python\u65b9\u6cd5\uff0c\u4e0d\u7528\u8bb0\u7e41\u7410\u7684API\u89c4\u5219\u5c31\u80fd\u8c03\u53d6 \u80a1 \u7968\u3001\u57fa\u91d1\u7b49\u5e02\u573a\u6570\u636e\u3002\u7279\u522b\u9002\u5408\u505a\u8fd9\u7c7b \u6570\u636e\u5206\u6790 \u7ec3\u4e60\uff0c\u4e0d\u9700\u8981\u914d\u7f6e\u672c\u5730\u73af\u5883\uff0c\u6253\u5f00\u7f51\u9875\u5c31\u80fd\u76f4\u63a5\u8fd0\u884c\u4ee3\u7801\u3002\u4ed6\u4eec\u7684\u4ea4\u4e92\u5f0f\u7f16\u8f91\u5668\u652f\u6301\u5b9e\u65f6\u9884\u89c8\u56fe\u8868\uff0c\u8fd8\u80fd\u628a\u6210\u54c1\u9879\u76ee\u4e00\u952e\u90e8\u7f72\u6210\u53ef\u8bbf\u95ee\u7684\u9875\u9762\uff0c\u7279\u522b\u9002\u5408\u5206\u4eab\u5206\u6790\u7ed3\u679c\u3002\u8bb0\u4f4f \u91d1\u878d \u6570\u636e\u5206\u6790 \u7684\u6838\u5fc3\u662f\uff1a1\uff09\u7406\u89e3\u4e1a\u52a1\u903b\u8f91 2\uff09\u786e\u4fdd\u6570\u636e\u8d28\u91cf 3\uff09\u7528\u5408\u9002\u7684\u53ef\u89c6\u5316\u5448\u73b0\u3002\u6bcf\u4e2a\u65b9\u6cd5\u90fd\u6709\u8be6\u7ec6\u7684\u53c2\u6570\u8bf4\u660e\uff0c\u6bd4\u5982\u8981\u83b7\u53d6\u7279\u65af\u62c9\u6700\u8fd1\u4e00\u5e74\u7684 \u80a1 \u4ef7\uff0c\u53ea\u9700\u8981\u4e24\u884c\u4ee3\u7801\u5c31\u80fd\u5b8c\u6210\u3002 LLMs\u4e4b openbb -agents\uff1a openbb -agents\u7684\u7b80\u4ecb\u3001\u5b89\u88c5\u548c \u4f7f\u7528 \u65b9\u6cd5\u3001\u6848\u4f8b\u5e94\u7528\u4e4b\u8be6\u7ec6\u653b\u7565 \u5934\u90e8AI\u793e\u533a\u5982\u6709\u9080\u535a\u4e3bAI\u4e3b\u9898\u6f14\u8bb2\u8bf7\u79c1\u4fe1\u2014\u5fc3\u6bd4\u5929\u9ad8\uff0c\u4ed7\u5251\u8d70\u5929\u6daf\uff0c\u4fdd\u6301\u70ed\u7231\uff0c\u5954\u8d74\u5411\u68a6\u60f3\uff01\u4f4e\u8c03\uff0c\u4e13\u6ce8\uff0c\u8c26\u865a\uff0c\u81ea\u5f8b\uff0c\u53cd\u601d\uff0c\u6210\u957f\uff0c\u8fd8\u7b97\u6bd4\u8f83\u6b63\u80fd\u91cf\u7684\u535a\u4e3b\uff0c\u516c\u76ca\u514d\u8d39\u4f20\u64ad\u2026\u5185\u5fc3\u7279\u522b\u60f3\u5728AI\u754c\u505a\u51fa\u4e00\u4e9b\u53ef\u4ee5\u63a8\u8fdb\u5386\u53f2\u8fdb\u7a0b\u5f71\u54cd\u529b\u7684\u6280\u672f(\u5174\u8da3\u4f7f\u7136\uff0c\u6709\u70b9\u5c0f\u60c5\u6000\uff0c\u4e5f\u6709\u70b9\u4f7f\u547d\u611f\u5440 08-27 3695 \u200b LLMs\u4e4b openbb -agents\uff1a openbb -agents\u7684\u7b80\u4ecb\u3001\u5b89\u88c5\u548c \u4f7f\u7528 \u65b9\u6cd5\u3001\u6848\u4f8b\u5e94\u7528\u4e4b\u8be6\u7ec6\u653b\u7565 \u76ee\u5f55 openbb -agents\u7684\u7b80\u4ecb openbb -agents\u7684\u5b89\u88c5\u548c \u4f7f\u7528 \u65b9\u6cd5 openbb -agents\u7684\u6848\u4f8b\u5e94\u7528 openbb -agents\u7684\u7b80\u4ecb \u8fd9\u662f\u4e00\u4e2a\u5229\u7528\u5927\u578b\u8bed\u8a00\u6a21\u578b\uff08LLMs\uff09\u548c\u5f00\u653eBB\u5e73\u53f0\uff08 OpenBB Platform\uff09\u6765\u521b\u5efa\u80fd\u591f\u81ea\u4e3b\u8fdb\u884c \u91d1\u878d \u7814\u7a76\u5e76 \u4f7f\u7528 \u6700\u65b0\u6570\u636e\u56de\u7b54\u95ee\u9898\u7684 \u91d1\u878d \u5206\u6790\u5e08\u4ee3\u7406\u7684\u9879\u76ee\u3002\u8fd9\u662f\u901a\u8fc7\u4ee3\u7406 \u4f7f\u7528 \u51fd\u6570\u8c03\u7528\u6765\u4e0e\u5f00\u653eBB\u5e73\u53f0\u4e92\u52a8\u5b9e\u73b0\u7684\u3002\u5f00\u653eBB\u8bed\u8a00 \u514d\u8d39\u4e14\u5b8c\u5168\u5f00\u6e90\u7684 \u91d1\u878d \u5e73\u53f0\uff0c \u91d1\u878d \u6570\u636e\u96c6\u8f6f\u4ef6 openbb skywalk8163\u7684\u4e13\u680f 02-03 1625 OpenBB \u662f\u4e00\u4e2a\u514d\u8d39\u5f00\u6e90\u7684 \u91d1\u878d \u6570\u636e\u5206\u6790 \u5e73\u53f0\uff0c\u63d0\u4f9b \u80a1 \u7968\u3001\u671f\u6743\u3001\u52a0\u5bc6\u8d27\u5e01\u7b49 \u91d1\u878d \u5de5\u5177\u7684\u8bbf\u95ee\u6743\u9650\u3002\u7528\u6237\u53ef\u901a\u8fc7pip\u5b89\u88c5 OpenBB \u6838\u5fc3\u5305\u548cCLI\u5de5\u5177\uff0c\u6216\u76f4\u63a5\u514b\u9686GitHub\u4ed3\u5e93\u3002\u5e73\u53f0\u652f\u6301Python\u811a\u672c\u8c03\u7528\u6570\u636e\u63a5\u53e3\uff0c\u5e76\u80fd\u901a\u8fc7FastAPI\u542f\u52a8\u672c\u5730\u670d\u52a1\uff08\u9ed8\u8ba4\u7aef\u53e36900\uff09\u3002\u5b89\u88c5\u8fc7\u7a0b\u4e2d\u53ef\u80fd\u9047\u5230Python\u73af\u5883\u95ee\u9898\uff0c\u9700\u786e\u4fdd\u7248\u672c\u517c\u5bb9\u6027\u3002\u5e73\u53f0\u8fd8\u63d0\u4f9b\u7f51\u9875\u7248\u670d\u52a1\uff0c\u7528\u6237\u53ef\u8fde\u63a5\u81ea\u5efa\u540e\u7aef\u8fdb\u884c \u6570\u636e\u5206\u6790 \u3002 OpenBB \uff1a\u5f00\u6e90 \u91d1\u878d \u6570\u636e\u5206\u6790 \u7684\u5f3a\u5927\u4e4b\u9009 xiezhipu\u7684\u535a\u5ba2 03-25 1856 OpenBB \u51ed\u501f\u5176\u5f00\u6e90\u3001\u514d\u8d39\u3001\u529f\u80fd\u5f3a\u5927\u7b49\u4f18\u52bf\uff0c\u6b63\u5728\u6539\u53d8 \u91d1\u878d \u6570\u636e\u5206\u6790 \u7684\u65b9\u5f0f\u3002\u5b83\u4e3a \u91d1\u878d \u4ece\u4e1a\u8005\u548c\u5f00\u53d1\u8005\u63d0\u4f9b\u4e86\u4e00\u4e2a\u9ad8\u6548\u3001\u7075\u6d3b\u7684\u5e73\u53f0\uff0c\u8ba9\u4ed6\u4eec\u80fd\u591f\u66f4\u52a0\u4fbf\u6377\u5730\u83b7\u53d6\u548c\u5206\u6790 \u91d1\u878d \u6570\u636e\u3002\u672a\u6765\uff0c\u968f\u7740\u793e\u533a\u7684\u4e0d\u65ad\u53d1\u5c55\u548c\u529f\u80fd\u7684\u6301\u7eed\u5b8c\u5584\uff0c OpenBB \u6709\u671b\u5728 \u91d1\u878d \u79d1\u6280\u9886\u57df\u53d1\u6325\u66f4\u52a0\u91cd\u8981\u7684\u4f5c\u7528\u3002\u5982\u679c\u60a8\u5bf9 OpenBB \u611f\u5174\u8da3\uff0c\u4e0d\u59a8\u8bbf\u95ee\u5176\u5b98\u65b9\u7f51\u7ad9\uff08 openbb .co\uff09\u6216 GitHub \u4ed3\u5e93\uff08github.com/ OpenBB -finance/ OpenBB \uff09\uff0c\u4e86\u89e3\u66f4\u591a\u8be6\u7ec6\u4fe1\u606f\u5e76\u5f00\u59cb \u4f7f\u7528 \u5427\uff01 OpenBB \u5f00\u653e\u6570\u636e\u5e73\u53f0\uff1a \u91d1\u878d \u6570\u636e\u96c6\u6210\u65b0\u5229\u5668 youxijun\u7684\u535a\u5ba2 02-23 174 OpenBB \u5f00\u653e\u6570\u636e\u5e73\u53f0\uff08ODP\uff09\u662f\u4e00\u5957\u5f00\u6e90\u5de5\u5177\u96c6\uff0c\u80fd\u96c6\u6210\u591a\u79cd\u6570\u636e\u6e90\u5230\u4e0b\u6e38\u5e94\u7528\u3002\u5b83\u4e0e OpenBB Workspace\u65e0\u7f1d\u96c6\u6210\uff0c\u4e3a\u5206\u6790\u5e08\u63d0\u4f9b\u4fbf\u5229\u3002\u4e0b\u9762\u4e00\u8d77\u6765\u4e86\u89e3\u5176\u7279\u70b9\u4e0e \u4f7f\u7528 \u65b9\u5f0f\u3002 \u3010GitHub\u9879\u76ee\u63a8\u8350-- OpenBB \uff1a\u5f00\u6e90 \u91d1\u878d \u6570\u636e\u5e73\u53f0\u3011\u2b50\u2b50\u2b50\u2b50\u2b50 j8267643\u7684\u535a\u5ba2 10-15 1644 \u200b OpenBB \u200b \u662f\u4e00\u4e2a\u5f00\u6e90 \u91d1\u878d \u6570\u636e\u5e73\u53f0\uff0c\u4e13\u4e3a\u5206\u6790\u5e08\u3001\u91cf\u5316\u4ea4\u6613\u5458\u548cAI\u667a\u80fd\u4f53\u8bbe\u8ba1\u3002\u8be5\u5e73\u53f0\u63d0\u4f9b\u5bf9 \u80a1 \u7968\u3001\u671f\u6743\u3001\u52a0\u5bc6\u8d27\u5e01\u3001\u5916\u6c47\u3001\u5b8f\u89c2\u7ecf\u6d4e\u3001\u56fa\u5b9a\u6536\u76ca\u7b49\u591a\u79cd \u91d1\u878d \u6570\u636e\u7684\u7edf\u4e00\u8bbf\u95ee\uff0c\u5e76\u901a\u8fc7\u4e30\u5bcc\u7684\u6269\u5c55\u529f\u80fd\u6ee1\u8db3\u7528\u6237\u7684\u4e2a\u6027\u5316\u9700\u6c42\u3002\ud83d\udd17 \u200bGitHub\u5730\u5740\ud83c\udf10 \u200b\u5b98\u65b9\u7f51\u7ad9\ud83d\ude80 \u200b\u6838\u5fc3\u4ef7\u503c\u200b\uff1a \u91d1\u878d \u6570\u636e \u00b7 \u5f00\u6e90\u5e73\u53f0 \u00b7 \u91cf\u5316\u5206\u6790 \u00b7 AI\u667a\u80fd\u4f53 \u00b7 \u7edf\u4e00\u63a5\u53e3\u200b\u9879\u76ee\u80cc\u666f\u200b\uff1a\u200b\u6570\u636e\u5206\u6563\u200b\uff1a \u91d1\u878d \u6570\u636e\u6765\u6e90\u5206\u6563\u200b\u5de5\u5177\u788e\u7247\u200b\uff1a\u5206\u6790\u5de5\u5177\u788e\u7247\u5316\u200b\u6210\u672c\u9ad8\u6602\u200b\uff1a\u4e13\u4e1a\u6570\u636e\u6210\u672c\u9ad8\u200b\u5f00\u6e90\u9700\u6c42\u200b\uff1a\u5f00\u6e90 \u91d1\u878d \u5de5\u5177\u9700\u6c42\u200bAI\u6574\u5408\u200b\uff1aAI\u4e0e \u91d1\u878d \u6574\u5408\u9700\u6c42\u200b\u3002 \u5982\u4f55 \u4f7f\u7528 OpenBB Workspace \u642d\u5efaA \u80a1 \u548c \u6e2f\u80a1 \u5206\u6790\u9762\u677f FinAnalyzer\u91d1\u878d\u5206\u6790\u5de5\u5177 09-25 2315 \u672c\u6587 \u4ecb\u7ecd \u4e86\u5982\u4f55 \u4f7f\u7528 OpenBB Workspace \u642d\u5efaA \u80a1 \u548c \u6e2f\u80a1 \u5206\u6790\u9762\u677f\uff0c\u4f9d\u6258 openbb -hka \u5e94\u7528\u53ca AKShare\u3001Tushare \u6570\u636e\u6e90\uff0c\u6db5\u76d6\u73af\u5883\u914d\u7f6e\u3001\u672c\u5730/Docker/Firebase \u90e8\u7f72\u65b9\u5f0f\uff0c\u5e76\u5c55\u793a\u9762\u677f\u529f\u80fd\u4e0eAI\u96c6\u6210\uff0c\u652f\u6301\u9ad8\u5ea6\u5b9a\u5236\u5316 \u91d1\u878d \u5206\u6790\u3002 \u4ece OpenBB \u5230 \u91d1\u878d OpenClaw\uff1a\u666e\u901a\u4eba\u5982\u4f55\u7528AI\u5f00\u53d1 \u91d1\u878d \u5e94\u7528 FinAnalyzer\u91d1\u878d\u5206\u6790\u5de5\u5177 03-17 565 OpenBB App Builder Agent\u9879\u76ee\u901a\u8fc7AI\u81ea\u52a8\u751f\u6210 \u91d1\u878d \u5206\u6790\u5e94\u7528\u540e\u7aef\u4ee3\u7801\uff0c\u5b9e\u73b0\u4e86\u4ece\u9700\u6c42\u63cf\u8ff0\u5230\u5b8c\u6574\u5e94\u7528\u7684\u95ed\u73af\u5f00\u53d1\u3002\u8be5\u9879\u76ee\u91c7\u7528\u4e09\u5c42\u67b6\u6784\u8bbe\u8ba1\uff08\u6570\u636e\u5e73\u53f0\u3001\u53ef\u89c6\u5316\u754c\u9762\u3001\u4e1a\u52a1\u903b\u8f91\u5c42\uff09\uff0c\u5e76\u7a81\u7834\u6027\u5730\u5f15\u5165\u5bf9\u8bdd\u5f0f\u5f00\u53d1\u6a21\u5f0f\uff0c\u7528\u6237\u4ec5\u9700\u81ea\u7136\u8bed\u8a00\u63cf\u8ff0\u5373\u53ef\u751f\u6210\u7b26\u5408\u89c4\u8303\u7684FastAPI\u540e\u7aef\u3002\u76f8\u6bd4\u901a\u7528AI\u5de5\u5177\uff0c\u8fd9\u79cd\u5782\u76f4\u9886\u57df\u7684\u4e13\u7528\u89e3\u51b3\u65b9\u6848\u5728\u6570\u636e\u53ef\u9760\u6027\u3001\u5206\u6790\u6548\u7387\u548c\u7528\u6237\u4f53\u9a8c\u65b9\u9762\u66f4\u5177\u4f18\u52bf\u3002\u867d\u7136\u4ecd\u5904\u65e9\u671f\u9636\u6bb5\uff0c\u8be5\u9879\u76ee\u5df2\u5c55\u73b0\u51fa \u91d1\u878d AI\u81ea\u4e3b\u8fdb\u5316\u7684\u6f5c\u529b\uff0c\u4e3a\u666e\u901a\u4eba\u5f00\u53d1\u4e13\u4e1a \u91d1\u878d \u5e94\u7528\u964d\u4f4e\u4e86\u95e8\u69db\u3002 OpenBB vs\u4f20\u7edf\u65b9\u6cd5\uff1a \u91d1\u878d \u5206\u6790\u6548\u7387\u63d0\u534710\u500d YellowSun24\u7684\u535a\u5ba2 11-30 830 \u7279\u522b\u662f OpenBB \u8fd9\u79cd\u9700\u8981\u591a\u4e2a\u4f9d\u8d56\u5305\u7684\u5de5\u5177\uff0c\u5728\u4f20\u7edf\u5f00\u53d1\u73af\u5883\u4e2d\u5b89\u88c5\u914d\u7f6e\u53ef\u80fd\u8981\u82b1\u4e0d\u5c11\u65f6\u95f4\uff0c\u4f46\u5728InsCode\u4e0a\u90fd\u662f\u9884\u88c5\u597d\u7684\uff0c\u771f\u6b63\u505a\u5230\u4e86\u5f00\u7bb1\u5373\u7528\u3002\u6700\u8ba9\u6211\u60ca\u559c\u7684\u662f\uff0c\u539f\u6765\u9700\u8981\u51e0\u5341\u884c\u4ee3\u7801\u624d\u80fd\u5b8c\u6210\u7684\u5de5\u4f5c\uff0c\u7528 OpenBB \u53ef\u80fd\u53ea\u9700\u8981\u51e0\u884c\u3002\u6bd4\u5982\u83b7\u53d6\u591a\u53ea \u80a1 \u7968\u7684\u5386\u53f2\u6570\u636e\u5e76\u8fdb\u884c\u6280\u672f\u5206\u6790\uff0c\u4f20\u7edf\u65b9\u6cd5\u53ef\u80fd\u8981\u5199100\u591a\u884c\u4ee3\u7801\uff0c\u800c OpenBB \u53ef\u80fd10\u884c\u5c31\u641e\u5b9a\u4e86\u3002\u6700\u8fd1\u5728\u505a\u4e00\u4e2a \u91d1\u878d \u6570\u636e\u5206\u6790 \u7684\u9879\u76ee\uff0c\u5c1d\u8bd5\u4e86\u4f20\u7edf\u7684pandas+yfinance\u7ec4\u5408\u548c\u65b0\u5174\u7684 OpenBB \u5de5\u5177\u5305\uff0c\u53d1\u73b0\u6548\u7387\u5dee\u8ddd\u975e\u5e38\u5927\u3002\u5982\u679c\u4f60\u4e5f\u5728\u505a\u7c7b\u4f3c\u7684\u5de5\u4f5c\uff0c\u5f3a\u70c8\u5efa\u8bae\u5c1d\u8bd5\u4e00\u4e0b\u8fd9\u4e2a\u7ec4\u5408\u3002 FinAnalyzer \u535a\u5ba2\u7b49\u7ea7 \u7801\u9f